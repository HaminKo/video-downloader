{
  "manifest_version": 3,
  "name": "Video Downloader",
  "version": "1.0",
  "description": "Send the page you're on to the Video Downloader app on this PC.",
  "key": "",
  "permissions": ["nativeMessaging", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send this page to Video Downloader",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
