{
  "manifest_version": 3,
  "name": "Video Downloader",
  "version": "1.1",
  "description": "Download the video on the page you're on with the Video Downloader app on this PC.",
  "key": "",
  "permissions": ["nativeMessaging", "activeTab", "storage"],
  "action": {
    "default_title": "Download this page's video with Video Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
